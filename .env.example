# PostgreSQL/Supabase connection used by Drizzle on the server
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Supabase project (safe browser values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only, never expose this to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: used by the secure admin bootstrap script
SUPABASE_ADMIN_EMAIL=admin@gbrbank.local
