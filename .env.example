# ============================================================
# GBR Bank — variáveis de ambiente
# Copie este arquivo para .env.local e preencha.
# NUNCA coloque .env.local nem a chave do Firebase no Git.
# ============================================================

# Fuso usado para "hoje", "este mês" e vencimentos atrasados.
# Sem isso, servidores na Vercel rodam em UTC e o dia pode virar 3h antes.
TZ=America/Sao_Paulo

# ------------------------------------------------------------
# Firebase / Cloud Firestore (acesso remoto de qualquer lugar)
# ------------------------------------------------------------
# Projeto (obrigatório para usar o Firestore)
FIREBASE_PROJECT_ID=gbrbank-d5878

# Conta de serviço (console do Firebase → Configurações do projeto →
# Contas de serviço → Gerar nova chave privada). São valores SECRETOS:
# só existem no servidor, nunca no navegador.
