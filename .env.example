# ============================================================
# GBR Bank — variáveis de ambiente
# Copie este arquivo para .env.local e preencha.
# NUNCA coloque .env.local nem a chave do Firebase no Git.
# ============================================================

# Fuso usado para "hoje", "este mês" e vencimentos atrasados.
# Sem isso, servidores na Vercel rodam em UTC e o dia pode virar 3h antes.
TZ=America/Sao_Paulo

# ------------------------------------------------------------
# Firebase / Cloud Firestore (acesso remoto de qualquer lugar)
# ------------------------------------------------------------
# Projeto (obrigatório para usar o Firestore)
FIREBASE_PROJECT_ID=seu-projeto.appspot.com

# Conta de serviço (console do Firebase → Configurações do projeto →
# Contas de serviço → Gerar nova chave privada). São valores SECRETOS:
# só existem no servidor, nunca no navegador.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternativa: cole o conteúdo inteiro do arquivo JSON da conta de serviço
# (pode ser em base64). Se preenchido, tem prioridade sobre as duas acima.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------
# Opcionais
# ------------------------------------------------------------
# E-mail do perfil criado no primeiro acesso
APP_ADMIN_EMAIL=admin@gbrbank.local

# Caminho do banco local usado APENAS quando o Firebase não está configurado
# LOCAL_DB_PATH=.data/gbr-bank-local.json
